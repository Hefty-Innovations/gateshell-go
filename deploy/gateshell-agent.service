[Unit]
Description=GateShell Agent — optional self-hosted metrics + alerting sidecar
Documentation=https://gateshell.com/agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gateshell-agent
Group=gateshell-agent

# EnvironmentFile carries the pairing token and any other secrets so they
# never appear in `systemctl status` / `ps` output. install.sh writes this
# for you; see internal/config for the full list of GATESHELL_AGENT_* vars.
EnvironmentFile=/etc/gateshell-agent/gateshell-agent.env

ExecStart=/usr/local/bin/gateshell-agent serve --config /etc/gateshell-agent/config.json
Restart=on-failure
RestartSec=5s

# Basic hardening. Loosen ProtectSystem/ReadWritePaths if DBPath lives
# outside /var/lib/gateshell-agent.
#
# /etc/gateshell-agent is listed too: PATCH /api/v1/config persists a
# changed poll interval to config.json via an atomic temp-file+rename
# write (see config.SavePollInterval), which needs write access to this
# directory. Without it, ProtectSystem=strict silently blocks that write
# regardless of the file's Unix permissions/ownership, and every interval
# change from the app applies at runtime but reports "could not be
# persisted" on every single install.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/gateshell-agent /etc/gateshell-agent

[Install]
WantedBy=multi-user.target
